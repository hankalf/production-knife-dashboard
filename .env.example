# Copy to .env and adjust for your environment.

# PostgreSQL connection string.
# Local dev: use the bundled docker-compose Postgres (see README), or your own.
# On Railway/Render: the database provides this automatically.
DATABASE_URL="postgresql://knife:knife@localhost:5432/knifedb?schema=public"

# Timezone used for due-date math ("end of today" for FC knives, "end of
# Friday" for NFC). Use an IANA name (e.g. America/Chicago, America/New_York,
# Europe/London). If unset, the server's local time is used — on most cloud
# hosts that is UTC, which is usually NOT what you want for shift cut-offs.
TZ="America/New_York"

# ---------------------------------------------------------------------------
# Self-hosting with docker compose (the Pi dashboard server). Ignore these if
# you deploy to Railway/Render — there, DATABASE_URL above is provided for you.
# ---------------------------------------------------------------------------

# Required for `docker compose up`. Compose refuses to start without it, so a
# default password can never reach a shared network by accident.
#   openssl rand -base64 24 | tr -d '/+='
# Keep it alphanumeric: it is substituted into DATABASE_URL, so / + @ : break it.
POSTGRES_PASSWORD=

# Optional; defaults shown.
# POSTGRES_USER=knife
# POSTGRES_DB=knifedb

# Host port the dashboard is served on. deploy.sh sets this from --port so the
# box can run several dashboards side by side.
APP_PORT=3000
